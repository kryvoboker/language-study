{
    "name": "language-study-frontend",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "engines": {
        "node": ">=25.6.1"
    },
    "scripts": {
        "dev": "nuxt dev",
        "build": "nuxt build",
