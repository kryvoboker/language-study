        "@tailwindcss/vite": "^4.3.3",
        "@types/node": "^26.6.1",
        "cross-env": "^10.0.0",
        "tailwindcss": "^4.3.3",
        "typescript": "^5.9.3",
        "vue-tsc": "^3.3.11"
    }
